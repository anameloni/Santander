inventario rápido de Functions Premium:

resources
| where type =~ 'microsoft.web/sites'
| where kind contains 'functionapp'
| extend AppServicePlanId = tostring(properties.serverFarmId)
| extend AppServicePlanName = extract(@"serverfarms/([^/]+)$", 1, AppServicePlanId)
| project
    FunctionApp = name,
    ResourceGroup = resourceGroup,
    Location = location,
    AppServicePlanName,
    AppServicePlanId




Obtener el SKU de los planes por separado:

resources
| where type =~ 'microsoft.web/serverfarms'
| project
    AppServicePlanName = name,
    Tier = tostring(sku.tier),
    Sku = tostring(sku.name),
    ResourceGroup = resourceGroup
| order by AppServicePlanName asc
